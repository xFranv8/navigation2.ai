<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_depth_costmap</name>
  <version>0.1.0</version>
  <description>
    Depth estimation and costmap integration for Nav2.
    Converts RGB images to depth using AI models (e.g., Depth Anything V2)
    and generates PointCloud2 for VoxelLayer consumption.
  </description>

  <maintainer email="xfranv8@example.com">xfranv8</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/xFranv8/navigation2.ai</url>
  <url type="repository">https://github.com/xFranv8/navigation2.ai</url>
  <url type="bugtracker">https://github.com/xFranv8/navigation2.ai/issues</url>

  <author email="xfranv8@example.com">xfranv8</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>opencv4</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
